set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(MV2_LLVM_ROOT "/workspace/toolchain/sysroot/usr/lib/llvm-19" CACHE PATH "LLVM installation")
set(MV2_WINDOWS_SDK "/workspace/toolchain/windows-sdk" CACHE PATH "Microsoft CRT and SDK prepared with xwin")
if(NOT EXISTS "${MV2_WINDOWS_SDK}/crt/include/vcruntime.h" OR NOT EXISTS "${MV2_WINDOWS_SDK}/sdk/include/um/Windows.h")
  message(FATAL_ERROR "Microsoft CRT/Windows SDK is missing. Run scripts/prepare-windows-sdk-cloud.sh after allowing download.visualstudio.microsoft.com.")
endif()
set(CMAKE_C_COMPILER "${MV2_LLVM_ROOT}/bin/clang-cl")
set(CMAKE_CXX_COMPILER "${MV2_LLVM_ROOT}/bin/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER "${MV2_LLVM_ROOT}/bin/lld-link")
set(CMAKE_AR "${MV2_LLVM_ROOT}/bin/llvm-lib")
set(CMAKE_RC_COMPILER "${MV2_LLVM_ROOT}/bin/llvm-rc")
set(CMAKE_MT "${MV2_LLVM_ROOT}/bin/llvm-mt")
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
set(sdk_includes "/imsvc${MV2_WINDOWS_SDK}/crt/include /imsvc${MV2_WINDOWS_SDK}/sdk/include/ucrt /imsvc${MV2_WINDOWS_SDK}/sdk/include/um /imsvc${MV2_WINDOWS_SDK}/sdk/include/shared /imsvc${MV2_WINDOWS_SDK}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${sdk_includes}")
set(CMAKE_CXX_FLAGS_INIT "${sdk_includes} /utf-8")
set(CMAKE_RC_FLAGS_INIT "/I${MV2_WINDOWS_SDK}/sdk/include/um /I${MV2_WINDOWS_SDK}/sdk/include/shared /I${MV2_WINDOWS_SDK}/sdk/include/ucrt")
set(sdk_libraries "/libpath:${MV2_WINDOWS_SDK}/crt/lib/x86_64 /libpath:${MV2_WINDOWS_SDK}/sdk/lib/um/x86_64 /libpath:${MV2_WINDOWS_SDK}/sdk/lib/ucrt/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${sdk_libraries}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${sdk_libraries}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${sdk_libraries}")
